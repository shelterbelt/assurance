		<!--
			package-engine: 2.0 packaging profile for the headless JSON-RPC engine.
			Produces, under target/engine-bundle/current/:
			  - engine.jar  : an executable shaded jar (Main-Class set, all deps inlined)
			  - jre/        : a jlink-trimmed runtime image
			Invoked from electron-forge's packageAfterCopy hook (see forge.config.ts);
			the path is host-shaped (current host = current produced bundle) — the per-
			platform variants are produced by running this profile on each target host.
		-->
		<profile>
			<id>package-engine</id>
			<activation>
				<property>
					<name>profile</name>
					<value>package-engine</value>
				</property>
			</activation>
			<properties>
				<release.identifier></release.identifier>
				<project.buildprefix></project.buildprefix>
				<release.tagname>snapshot</release.tagname>
				<engine.bundle.dir>${project.build.directory}/engine-bundle/current</engine.bundle.dir>
				<engine.jar.path>${engine.bundle.dir}/engine.jar</engine.jar.path>
				<engine.jre.path>${engine.bundle.dir}/jre</engine.jre.path>
				<engine.jlink.modules>java.se,jdk.crypto.ec,jdk.crypto.cryptoki,jdk.unsupported,jdk.management,jdk.management.agent,jdk.naming.dns,jdk.naming.rmi,jdk.localedata</engine.jlink.modules>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<version>3.5.1</version>
						<executions>
							<execution>
								<id>shade-engine</id>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<createDependencyReducedPom>false</createDependencyReducedPom>
									<outputFile>${engine.jar.path}</outputFile>
									<filters>
										<filter>
											<!-- Drop signed-jar signatures: shading combines jars and the originals' signatures no longer match. -->
											<artifact>*:*</artifact>
											<excludes>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
												<exclude>module-info.class</exclude>
											</excludes>
										</filter>
									</filters>
									<transformers>
										<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<mainClass>com.markallenjohnson.assurance.Application</mainClass>
											<manifestEntries>
												<Implementation-Build>${project.buildprefix}${buildNumber}</Implementation-Build>
												<Implementation-Version>${project.version}</Implementation-Version>
											</manifestEntries>
										</transformer>
										<!-- Coalesce ServiceLoader registrations across all dependency jars. -->
										<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
										<!-- Coalesce Spring's namespace-handler / schema / factories descriptors. -->
										<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
											<resource>META-INF/spring.handlers</resource>
										</transformer>
										<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
											<resource>META-INF/spring.schemas</resource>
										</transformer>
										<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
											<resource>META-INF/spring.factories</resource>
										</transformer>
										<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
											<resource>META-INF/spring.tooling</resource>
										</transformer>
									</transformers>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<!-- Drive the JDK's bundled jlink to produce a trimmed runtime image. The
							 module set covers Spring + Hibernate + Jackson + Java-WebSocket + log4j
							 needs without pulling in the full JDK; trim further only after a
							 measured packaged-app smoke. -->
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.1.1</version>
						<executions>
							<execution>
								<id>jlink-engine-jre</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${java.home}/bin/jlink</executable>
									<arguments>
										<argument>--add-modules</argument>
										<argument>${engine.jlink.modules}</argument>
										<argument>--strip-debug</argument>
										<argument>--no-header-files</argument>
										<argument>--no-man-pages</argument>
										<argument>--compress=2</argument>
										<argument>--output</argument>
										<argument>${engine.jre.path}</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<!-- Wipe target/engine-bundle/current/jre/ before jlink runs (jlink refuses
							 to overwrite). Also wipe the shaded engine.jar so re-runs are clean. -->
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-clean-plugin</artifactId>
						<version>3.3.2</version>
						<executions>
							<execution>
								<id>clean-engine-bundle</id>
								<phase>generate-resources</phase>
								<goals>
									<goal>clean</goal>
								</goals>
								<configuration>
									<excludeDefaultDirectories>true</excludeDefaultDirectories>
									<filesets>
										<fileset>
											<directory>${engine.bundle.dir}</directory>
										</fileset>
									</filesets>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
